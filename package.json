{
  "name": "diadochi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:ground && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:world-terrain": "node --experimental-strip-types scripts/import-world-geography.mjs",
    "generate:map": "node --experimental-strip-types scripts/generate-map.mjs",
    "generate:theatre": "node --experimental-strip-types scripts/generate-theatre.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:map": "node --experimental-strip-types scripts/benchmark-map.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "check:browser-pan": "node --experimental-strip-types scripts/check-map-pan.mjs",
    "check:browser-loading": "node scripts/check-prepared-loading.mjs",
    "check:browser-sharpness": "node scripts/check-map-sharpness.mjs",
    "generate:barriers": "node --experimental-strip-types scripts/generate-mountain-terrain.mjs",
    "generate:ground": "node --experimental-strip-types scripts/generate-ground-artwork.mjs",
    "check:ground": "node --experimental-strip-types scripts/check-ground-artwork.mjs",
    "check:browser-susa": "node scripts/check-susa-development.mjs",
    "check:browser-assyria": "node scripts/check-assyria-development.mjs",
    "check:browser-persis": "node scripts/check-persis-development.mjs",
    "check:browser-media": "node scripts/check-media-geography.mjs",
    "check:browser-mountains": "node --experimental-strip-types scripts/check-mountain-terrain.mjs",
    "check:browser-babylonia": "node scripts/check-babylonia-development.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "polygon-clipping": "^0.15.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
